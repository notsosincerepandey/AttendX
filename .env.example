# ========================================================
# AttendX Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or any real secrets to version control.
# ========================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Web Push Notification Configuration (VAPID RFC 8292)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-base64url
VAPID_PRIVATE_KEY=your-vapid-private-key-base64url
VAPID_SUBJECT=mailto:admin@yourdomain.edu

# Background Jobs / Cron Secret
CRON_SECRET=your-random-32-char-cron-secret

# Development / Testing (Optional - leave unset in production)
# DEV_SEED_PASSWORD=your-local-dev-seed-password
# DEFAULT_STUDENT_PASSWORD=your-default-student-password
